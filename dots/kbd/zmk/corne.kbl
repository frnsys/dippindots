ALPHA

* Q L D C B ◆  ↑ ⇥ F O U J `
- N R T S G ⎇  ↓ Y H A E I :
/ X V M W Z      K P , ' . _
      ⎋ ⌫ s      ⏎ ␣ ⎈

holds:
  ␣: Layer(NUMSYM)
  ⏎: Layer(ARROWS)

defs:
  s: Shift
  ␖: Enable(NUMSYM)
  a: Enable(ARROWS)

combos:
  # Layers
  [H, I]: Enable(SYSTEM)
  [N, S]: Enable(SYSTEM)

  # Modifiers
  [P, "'"]:  OneShot(Meta)

  # Shortcuts
  [R, T, S]: Shift(Alt(C))     # Terminal copy
  [N, R, T, S]: Shift(Alt(P))  # Terminal paste
  [Q, L]: Ctrl(Z)              # Undo
  [X, V, M, W]: ↺              # Bootloader

  # Accents
  [N, ⌫]: "ˆ"
  [R, ⌫]: "´"
  [T, ⌫]: "ˋ"
  [G, ⌫]: "¨"
  [S, ⌫]: "€"
  [O, ␣]: "¸"

  # Special
  [T, S]: "⇥"

  # Symbols
  [",", "'"]: ">"
  ["V", "M"]: "<"

  # For Blender
  [N, R]: "Y"
  [N, D]: "⏎"

shifts:
  ',': '?'
  "'": '"'
  '.': ';'
  ':': '!'
  '`': '@'
  '/': '+'
  '-': '='
  '*': '&'
  '_': '\\'

---

NUMSYM

⬚ ^ 4 5 6 0 ⬚  ⬚ ⬚ # [ ] ^ @
⬚ 0 1 2 3 % ⬚  ⬚ ⬚ { ( ) } $
⬚ . 7 8 9 ,      ⬚ | < > % ~
      ⬚ ⬚ ⬚      ⬚ ⬚ ⬚

---

ARROWS

⬚ ⬚ ⬚ ⬚ ⬚ ⬚ ⬚  ⬚ ⬚ ⇞ ↑ ⇟ ⬚ ⬚
⬚ ⬚ ⬚ ⬚ ⬚ ⬚ ⬚  ⬚ ⬚ ← ↓ → ⬚ ⬚
⬚ ⬚ ⬚ ⬚ ⬚ ⬚      ⬚ ⬚ ⬚ ⬚ ⬚ ⬚
      ⬚ ⬚ ⬚      ⬚ ⬚ ⬚
---

SYSTEM

⬚ ⬚ ⇲ ⍐ ⇱ ⬚ ⬚  ⬚ ⬚ ℌ ⊕ ॥ ⬚ ⬚
⬚ ⇧ ⇐ ↫ ⇒ ⇑ ⬚  ⬚ ⎶ ❮ ✛ ◱ ❯ ⬚
⬚ ◐ ⏷ ▶ ⏶ ◑      ⬚ ⬚ ⬚ ⬚ ⬚ ⬚
      ⬚ ⇧ ⬚      ⬚ ⍜ ⬚

defs:
  ⇐: Meta(←)        # Focus previous column
  ⇒: Meta(→)        # Focus next column
  ↫: Meta(↓)        # Focus previously focused window
  ⇑: Meta(↑)        # Focus previous workspace
  ⍐: Meta(Ctrl(↑))  # Focus next monitor
  ⇱: Meta(Alt(→))   # Size up column
  ⇲: Meta(Alt(←))   # Size down column
  ⍜: Meta(␣)        # Launcher
  ▶: Meta(=)        # Play/pause music
  ❮: Alt([)         # Prev term tab
  ❯: Alt(])         # Next term tab
  ⊕: Alt(T)         # New tab
  ⎶: Alt(-)         # Horizontal split
  ॥: Alt(\)         # Vertical split
  ◱: Alt(M)         # Maximize term window
  ✛: Alt(W)         # Focus term window
  ℌ: Alt(E)         # Scrollback history
combos:
  [⏷, ⏶]: ⨯               # Mute
  [⏷, ▶, ⏶]: Meta(Alt(O)) # Monitor sleep
  [◐, ◑]: ◌               # Bluetooth clear profile
shifts:
  ▶: Meta(=)        # Play/pause mpv
  ⏶: ☼              # Brightness up
  ⏷: ☾              # Brightness down

===

mt: mod_tap {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    bindings = <&kp>, <&kp>;
    display-name = "Mod-Tap";
    retro-tap;
};

lt: layer_tap {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    flavor = "tap-preferred";
    tapping-term-ms = <175>;
    quick-tap-ms = <150>;
    bindings = <&mo>, <&kp>;
    display-name = "Layer-Tap";
    retro-tap;
};
